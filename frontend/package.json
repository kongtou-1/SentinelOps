{
  "name": "sentinelops-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1",
    "build:desktop": "vue-tsc --noEmit && vite build --mode desktop",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "api:types": "openapi-typescript ../docs/backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dompurify": "^3.2.7",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.4",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "openapi-typescript": "^7.9.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@11.19.0"
}
