# Run backend/scripts/init_env.py to generate .env with random secrets.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ops_platform
POSTGRES_USER=ops_platform
POSTGRES_PASSWORD=

# Optional source synchronization (API remains available without source-worker)
SOURCE_SYNC_TIMEOUT_SECONDS=120
SOURCE_MAX_FILE_BYTES=2097152
SOURCE_MAX_SNAPSHOT_BYTES=104857600
SOURCE_MAX_FILES=10000
SOURCE_MAX_CACHE_BYTES=1073741824
SOURCE_MAX_STORE_BYTES=5368709120
# Optional SVN enterprise CA path inside the source-worker container; mount the PEM read-only.
# SOURCE_SVN_CA_FILE=/etc/source-ca/svn.pem
JWT_SECRET=
JWT_ISSUER=ops-platform
JWT_AUDIENCE=ops-platform-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
BACKEND_PORT=8000
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
PROMETHEUS_URL=http://127.0.0.1:9090
# Defaults deliver only to local Mailpit. Configure real SMTP explicitly when needed.
SMTP_ADDRESS=mailpit:1025
SMTP_FROM=alerts@example.test
SMTP_TO=operator@example.test
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Backend/report-worker consume only the restricted password file prepared from SMTP_PASSWORD.
# Host-side exports can set REPORT_FONT_FILE to the same font copied from the Docker image.
# AI diagnosis is opt-in; credentials remain in .local/ai-secrets/deepseek.key.
AI_ENABLED=false
# Set mock only for an explicitly isolated simulated Provider; mock usage is not billed.
AI_PROVIDER_KIND=model
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_SECONDS=180
# Agent inspection Python uses a separate broker; no host execution fallback.
# The compose.inspection-agent.yaml override configures these for backend.
INSPECTION_SANDBOX_URL=
INSPECTION_SANDBOX_TOKEN_FILE=.local/inspection-sandbox.token
# Expected workers for the full startup profiles; health is separate from DB readiness.
BACKEND_WORKERS=operations,prediction,source,inspection,ai,report
PLATFORM_WORKERS=operations,prediction,source,inspection,ai,report,execution
# Optional local collector socket group; use the real Linux Docker socket GID.
DOCKER_SOCKET_GID=0
