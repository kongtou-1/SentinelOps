        "dataset.schema"
      ],
      "expect": {
        "outcome": "sql",
        "tables": [
          "orders"
        ],
        "sql_all": [
          "from orders"
        ],
        "sql_any": [
          [
            "count("
          ]
        ],
        "sql_none": [
          "select *"
        ],
        "notes": "纯结构问题，不需要业务口径",
        "signals": []
      },
      "reference_sql": "SELECT COUNT(*) AS total FROM orders"
    },
    {
